# ==============================================================================
# .gitignore for Wedding Invite Motion Web App
# ==============================================================================

# --- Sensitive Files & Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/
credentials/
id_rsa
id_ed25519

# --- Operating System Files ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# --- IDE & Editor Artifacts ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Temporary & Extraction Dumps ---
*.tmp
*.temp
*.bak
*.FlateDecode
*.DCTDecode
scratch/
tmp/
temp/

# --- Node & Package Managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/

# --- Logs & Crash Dumps ---
*.log
*.dump
*.stackdump
